{
  "name": "guitarz4u",
  "version": "1.0.0",
  "private": true,
  "description": "Guitarz4U — second-hand guitar shop and repair service website (Sandringham, Johannesburg).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test --experimental-strip-types tests/unit/*.test.ts",
    "test:db": "node tests/db/run-db-tests.mjs",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test:e2e:fresh": "supabase db reset && playwright test",
    "test:all": "npm run test:unit && supabase db reset && playwright test && npm run test:db",
    "content:build": "node scripts/build-content-migration.mjs",
    "icons:build": "node scripts/build-icons.mjs",
    "setup-sql:build": "node scripts/build-setup-sql.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.3",
    "nodemailer": "^10.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "supabase": "^2.122.0",
    "typescript": "5.9"
  }
}
