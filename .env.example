# ─────────────────────────────────────────────────────────────
# Guitarz4U environment configuration
# Copy to .env (local) or set in your hosting dashboard (production).
# NEVER commit real values. Empty optional values = feature disabled.
# ─────────────────────────────────────────────────────────────

# Required ─────────────────────────────────────────────────────
# PostgreSQL connection string. Production: use SSL (add ?sslmode=require for most providers).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/guitarz4u?schema=public"
# The public URL of the site (used in emails, payment return URLs and SEO). No trailing slash.
APP_URL="https://www.your-domain.com"
# Long random string protecting /api/cron/maintenance. Generate: openssl rand -hex 32
CRON_SECRET=""

# Card payments: PayFast (https://payfast.io) ─────────────────
# "sandbox" for testing, "live" only after PayFast approves your account.
PAYFAST_MODE="sandbox"
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
# Set the same passphrase in PayFast dashboard → Settings → Developer Settings.
PAYFAST_PASSPHRASE=""
# Keep "true". PayFast notifications are confirmed directly with PayFast's servers.
PAYFAST_VALIDATE_WITH_SERVER="true"

# Transactional email (any SMTP provider) ──────────────────────
# e.g. Brevo: smtp-relay.brevo.com:587, Resend: smtp.resend.com:465 (secure=true)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# Must be an address on a domain you have verified with the email provider.
EMAIL_FROM="Guitarz4U <no-reply@your-domain.com>"
# Where owner alerts go (defaults to Joshuaweinfas@gmail.com).
ADMIN_NOTIFICATION_EMAIL=""

# File storage ─────────────────────────────────────────────────
# "local" stores files on the server disk (development / single VPS with a persistent volume).
# "s3" uses any S3-compatible PRIVATE bucket (Cloudflare R2 recommended).
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"
S3_ENDPOINT=""          # e.g. https://<account-id>.r2.cloudflarestorage.com
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Optional: official WhatsApp Business Cloud API (Meta) ────────
# Only used for customers who opted in. Leave empty to use manual WhatsApp links only.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_TEMPLATE_LANGUAGE="en"

# Optional: AI-assisted price estimates (Anthropic Claude) ────
# Estimates are labelled, never applied automatically and need owner approval.
ANTHROPIC_API_KEY=""
AI_PRICING_MODEL="claude-opus-5-5"
