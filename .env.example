# -----------------------------------------------------------------------------
# Guitarz4U environment variables
# Copy this file to .env.local for local development.
# On Netlify, add the same names under Site configuration -> Environment variables.
# NEVER commit real secrets. .env.local is ignored by git.
# -----------------------------------------------------------------------------

# Public site address (no trailing slash). Example: https://guitarz4u.netlify.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project settings -> API keys
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The "publishable" key (or the legacy "anon" key). Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET key (or legacy "service_role" key). SERVER ONLY. Bypasses all security
# rules, so never prefix it with NEXT_PUBLIC_ and never share it.
# Only used to delete auth accounts when processing POPIA deletion requests.
SUPABASE_SECRET_KEY=

# Set to "true" ONLY after configuring Google sign-in in Supabase (see docs/SETUP.md).
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Optional: email notifications to the owner and status emails to customers.
# Leave blank to use in-app notifications only. See docs/SETUP.md (Gmail app
# password or Brevo free SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Guitarz4U <your-address@example.com>"
ADMIN_NOTIFICATION_EMAIL=
