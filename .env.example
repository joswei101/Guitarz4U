# =============================================================================
# Guitarz4U environment variables
# Copy this file to ".env.local" for local development. On Netlify, add the
# same names under Site configuration → Environment variables.
# NEVER commit real values. Only variables starting with NEXT_PUBLIC_ are
# visible in the browser — everything else stays on the server.
# =============================================================================

# Public website address (no trailing slash). Used for links, sitemap, emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings → API). The publishable/anon key is safe
# to expose: Row-Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Set to "true" ONLY after configuring Google sign-in in Supabase
# (see docs/SETUP.md → Google sign-in). Otherwise the button is hidden.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# -----------------------------------------------------------------------------
# OPTIONAL — automatic email notifications (server-only secrets).
# Leave blank to disable. The dashboard will then show "Email not sent" and
# you contact customers manually via WhatsApp/email links.
# -----------------------------------------------------------------------------
# Supabase secret/service-role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# SMTP (e.g. Gmail with an App Password: smtp.gmail.com, port 465)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Guitarz4U <yourname@gmail.com>"
# Where admin notifications are emailed
ADMIN_NOTIFICATION_EMAIL=Joshuaweinfas@gmail.com
