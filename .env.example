# =============================================================================
# Guitarz4U environment variables — TEMPLATE ONLY. Never put real values here.
# Copy to .env.local for local development, and enter the real values in
# Netlify: Site configuration → Environment variables.
# Full explanation of each variable: docs/BEGINNER-GUIDE.md (Phase D).
# =============================================================================

# --- Website address (public) -------------------------------------------------
# Your live website address, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-site-name.netlify.app

# --- Supabase (database, accounts, file storage) -----------------------------
# Supabase dashboard → Project Settings → API / API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (starts with sb_publishable_) or the legacy "anon" key. Safe to be public.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# SECRET key (starts with sb_secret_) or the legacy "service_role" key.
# KEEP SECRET. Never share it, never put it in browser code or GitHub.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# --- Email notifications via SMTP (secret) ------------------------------------
# Recommended at launch: Gmail with an App Password (see docs/BEGINNER-GUIDE.md, Phase F).
# Later, with your own domain, Brevo or similar is better for deliverability.
# Leave SMTP_HOST empty to disable email: notifications are then marked "skipped".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=Joshuaweinfas@gmail.com
SMTP_PASSWORD=your-16-character-app-password
# The "From" address. With Gmail it must be the same Gmail address as SMTP_USER.
EMAIL_FROM="Guitarz4U <Joshuaweinfas@gmail.com>"

# --- Security (secret) -------------------------------------------------------
# A long random string used to anonymise IP addresses for spam protection.
# Generate one at https://www.random.org/strings/ or with: openssl rand -hex 32
IP_HASH_SALT=change-me-to-a-long-random-string
# Protects the /api/cron/maintenance endpoint used by the optional GitHub Action.
CRON_SECRET=change-me-to-another-long-random-string

# --- Optional: Cloudflare Turnstile spam protection (free) -------------------
# Leave both empty to rely on the built-in honeypot + rate limiting only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Optional: Cloudflare Web Analytics (free, cookie-free) ------------------
# Only loaded for visitors who allow analytics.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
