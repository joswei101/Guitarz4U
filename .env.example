# ───────────── Guitarz4U environment variables ─────────────
# Copy this file to `.env.local` for local development. On Netlify, add the same
# names under Site configuration → Environment variables. NEVER commit real values.

# Public address of the site (no trailing slash). Locally: http://localhost:3000
SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Long random secret used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string

# PostgreSQL connection string. For Supabase use the "Transaction pooler"
# connection string (port 6543) from Project Settings → Database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/guitarz4u
# Set to "true" for hosted databases that require SSL (Supabase, Neon).
DATABASE_SSL=false

# ── Image storage ──
# "local" saves files in ./uploads (development only — Netlify's disk is not permanent).
# "s3" uses any S3-compatible storage, e.g. Supabase Storage (free 1 GB).
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public bucket for product photos, and a PRIVATE bucket for seller/repair photos.
S3_PUBLIC_BUCKET=product-images
S3_PRIVATE_BUCKET=private-uploads
# Public URL prefix of the public bucket, e.g.
# https://YOURPROJECT.supabase.co/storage/v1/object/public/product-images
S3_PUBLIC_URL=

# ── Email (optional) ── Any SMTP service: Brevo free (300/day) or Gmail with an App Password.
# Leave SMTP_HOST empty to disable email; the site then says so honestly.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Guitarz4U <Joshuaweinfas@gmail.com>"
# Where new-request alerts are emailed (in-app notifications always work).
ADMIN_NOTIFY_EMAIL=Joshuaweinfas@gmail.com

# ── Google sign-in (optional) ── Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
